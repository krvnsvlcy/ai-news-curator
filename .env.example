# Used by the worker (apps/worker). The web app reads apps/web/.env.local.

# MongoDB. Credentials can be in the URL or set separately below (separate values win).
MONGO_DB_URL=mongodb+srv://cluster0.example.mongodb.net
MONGO_DB_USER=
MONGO_DB_PASSWORD=
MONGO_DB_NAME=ai-news-curator

# The Guardian Content API key: https://open-platform.theguardian.com/access/
GUARDIAN_API_KEY=
