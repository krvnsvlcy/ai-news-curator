# Shared password for the internal tool
AUTH_PASSWORD=change-me
# Signs session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET=

# MongoDB (same values as the worker's root .env)
MONGO_DB_URL=mongodb+srv://cluster0.example.mongodb.net
MONGO_DB_USER=
MONGO_DB_PASSWORD=
MONGO_DB_NAME=ai-news-curator

# Needed for "Fetch now" on Guardian sources
GUARDIAN_API_KEY=
