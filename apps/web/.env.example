# Shared password for the internal tool
AUTH_PASSWORD=change-me
# Optional hint shown on the login page. Visible to anyone who opens it: never the password itself.
AUTH_PASSWORD_HINT=
# Signs session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET=

# MongoDB (same values as the worker's root .env)
MONGO_DB_URL=mongodb+srv://cluster0.example.mongodb.net
MONGO_DB_USER=
MONGO_DB_PASSWORD=
MONGO_DB_NAME=ai-news-curator

# Needed for "Fetch now" on Guardian sources
GUARDIAN_API_KEY=

# Vercel AI Gateway (Claude), for the New letter walkthrough and AI assistance in the
# editor. Create a key in Vercel under AI > API Keys. Not needed on Vercel, where OIDC is used.
AI_GATEWAY_API_KEY=

# Shown in the email masthead and footer
NEWSLETTER_NAME=The Curator Daily
NEWSLETTER_TAGLINE=

# Email delivery (SMTP). For safe local testing, run Mailpit and nothing reaches real inboxes:
#   docker run -d --rm -p 1025:1025 -p 8025:8025 axllent/mailpit   (inbox at http://localhost:8025)
SMTP_URL=smtp://localhost:1025
SMTP_FROM=The Curator Daily <letters@example.com>
# Base URL for click/open tracking links in emails. Defaults to the URL the app was opened at.
APP_URL=

# Optional "Built by …" credit on the login page and at the bottom of the sidebar.
# Hidden when ATTRIBUTION_NAME is empty; the URL is optional (http/https only).
ATTRIBUTION_NAME=
ATTRIBUTION_URL=

# Signs tracked links in sent emails (click + open tokens) and keys the
# pseudonymous reader ids used by analytics. Defaults to AUTH_SECRET. If you set it,
# keep it stable: changing it invalidates links in emails already sent.
TRACKING_SECRET=

# PostHog browser analytics
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
