{
  "name": "@curator/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts run",
    "start": "node --env-file-if-exists=../../.env dist/index.js run",
    "once": "node --env-file-if-exists=../../.env dist/index.js once",
    "seed": "node --env-file-if-exists=../../.env dist/index.js seed",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@curator/tsconfig": "workspace:*",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@curator/db": "workspace:*",
    "@curator/ingest": "workspace:*"
  }
}
